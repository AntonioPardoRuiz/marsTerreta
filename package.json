{
  "name": "mars-corporativa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build && node scripts/seo-assets.mjs",
    "test": "ng test --watch=false",
    "seo": "node scripts/seo-assets.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve-preview.mjs",
    "audit": "node scripts/audit.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"scripts/*.mjs\" \"e2e/*.ts\" \"*.{json,ts,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"scripts/*.mjs\" \"e2e/*.ts\" \"*.{json,ts,md}\" \"docs/*.md\"",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "^22.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  }
}
